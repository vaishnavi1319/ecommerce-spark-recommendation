# ============================================================
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=ecommerce_spark

# AWS S3 Configuration (Optional - for Cloud deployment)
# Leave empty/placeholder to run in local mode only.
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ecommerce-spark-dataset

# AWS EMR Configuration (Optional - distributed Spark on cloud)
EMR_LOG_URI=s3://ecommerce-spark-dataset/emr-logs/
EMR_EC2_KEY_PAIR=
EMR_SUBNET_ID=

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=EcommerceRecommendation
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Dataset
DATASET_PATH=data/raw/ecommerce_interactions.csv
LARGE_DATASET_PATH=data/raw/ecommerce_large.csv
PROCESSED_DATA_PATH=data/processed/
MODEL_PATH=data/processed/als_model

# Admin
ADMIN_EMAIL=admin@sparkrec.com
ADMIN_PASSWORD=Admin@123

# App
PORT=5000
HOST=0.0.0.0
