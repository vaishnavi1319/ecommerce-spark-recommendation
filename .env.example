# ============================================================
# Environment Configuration Template
# E-Commerce Product Recommendation Using Apache Spark
# Copy this file to .env and configure values for your environment
# ============================================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_KEY

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=ecommerce_spark

# AWS S3 Configuration (Optional)
# Configure real AWS credentials only in your local .env file.
# Never commit actual credentials to GitHub.
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ecommerce-spark-dataset

# AWS EMR Configuration (Optional)
EMR_LOG_URI=s3://ecommerce-spark-dataset/emr-logs/
EMR_EC2_KEY_PAIR=
EMR_SUBNET_ID=

# Apache Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=EcommerceRecommendation
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Dataset Configuration
DATASET_PATH=data/raw/ecommerce_interactions.csv
LARGE_DATASET_PATH=data/raw/ecommerce_large.csv
PROCESSED_DATA_PATH=data/processed/
MODEL_PATH=data/processed/als_model

# Administrator Configuration
ADMIN_EMAIL=admin@sparkrec.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Application Configuration
PORT=5000
HOST=127.0.0.1
